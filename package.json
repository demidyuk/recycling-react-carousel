{
  "name": "recycling-react-carousel",
  "version": "2.0.0",
  "description": "A React carousel that reuses slide containers for large collections",
  "keywords": [
    "react",
    "react-carousel",
    "carousel",
    "slider",
    "virtualization",
    "recycling",
    "drag",
    "swipe",
    "momentum",
    "spring",
    "responsive"
  ],
  "license": "MIT",
  "author": "Denis Demidyuk <denisdemidyuk@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demidyuk/recycling-react-carousel.git"
  },
  "homepage": "https://github.com/demidyuk/recycling-react-carousel",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": true,
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "npm run storybook",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/create-cjs-types.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:package": "node scripts/test-package.mjs",
    "test:package:browser": "node scripts/test-package.mjs --browser",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "storybook": "node scripts/storybook.mjs public dev",
    "storybook:test": "node scripts/storybook.mjs test dev",
    "build-storybook": "node scripts/storybook.mjs public build",
    "pack:check": "publint && attw --pack .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run size && npm run pack:check && npm run test:package",
    "release": "semantic-release"
  },
  "size-limit": [
    {
      "name": "ESM",
      "path": "dist/index.js",
      "limit": "16.5 KB"
    },
    {
      "name": "CommonJS",
      "path": "dist/index.cjs",
      "limit": "16.75 KB"
    },
    {
      "name": "useCarousel only",
      "path": "dist/index.js",
      "import": "{ useCarousel }",
      "limit": "2.5 KB"
    }
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@size-limit/preset-small-lib": "^13.0.1",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semantic-release": "^25.0.9",
    "size-limit": "^13.0.1",
    "storybook": "^10.5.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^4.1.10"
  }
}
