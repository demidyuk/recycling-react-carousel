{
  "extends": "./tsconfig.json",
  "include": ["src", "types"],
  "exclude": ["**/__tests__", "**/__mocks__", "**/*.test.*"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "types": []
  }
}
